# Public builds leave these values empty and use the offline AI demo.
# EXPO_PUBLIC values are embedded in the client bundle. They are only suitable
# for private local evaluation, never for distributing production secrets.
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_AI_BASE_URL=https://api.deepseek.com/v1
EXPO_PUBLIC_AI_MODEL=deepseek-chat
EXPO_PUBLIC_AMAP_API_KEY=
