{
  "expo": {
    "name": "AI Schedule Assistant",
    "slug": "ai-schedule-assistant",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "primaryColor": "#F8FAFC",
    "jsEngine": "hermes",
    "scheme": "aischedule",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#EFFAFA",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AI日程助手需要获取你的位置以提供周边餐厅、交通和天气等个性化推荐。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AI日程助手需要获取你的位置以提供周边餐厅、交通和天气等个性化推荐。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EFFAFA",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "backgroundColor": "#EFFAFA",
      "package": "com.codex.aischeduleassistant",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    }
  }
}
